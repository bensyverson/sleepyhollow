#!/bin/bash
# Pre-commit: swiftformat the staged Swift files, then run the full suite.
# Never recurses into .claude/worktrees: only staged paths are formatted, and
# swift test builds only this package's targets.
set -e
cd "$(git rev-parse --show-toplevel)"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.swift$' || true)

if [ -n "$STAGED_FILES" ]; then
    if ! command -v swiftformat &> /dev/null; then
        echo "Error: swiftformat is not installed."
        echo "Install it with: brew install swiftformat"
        exit 1
    fi
    # Note: re-adding stages the whole file, including any unstaged hunks —
    # the accepted tradeoff of format-on-commit.
    echo "Running SwiftFormat on staged files..."
    for FILE in $STAGED_FILES; do
        if [ -f "$FILE" ]; then
            swiftformat "$FILE" --quiet
            git add "$FILE"
        fi
    done
fi

swift test --quiet

# Shared agent rules: refuse a commit that leaves AGENTS.md or a generated
# project/agents/ file stale or hand-edited. `agents` is built from ~/git/agents.
echo "==> agents check"
if command -v agents > /dev/null; then
  agents check || exit 1
else
  echo "agents is not installed (go install from ~/git/agents); skipping"
fi
